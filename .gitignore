# Ignorar archivos de configuración con credenciales reales de base de datos.
# Las conexiones (config/conexion.php y config/conexion_sqlserver.php) SÍ se versionan;
# las credenciales van en estos archivos, que se crean copiando los *.example.php.
config/config_mysql.php
config/config_sqlserver.php
config/config_wms.php

# Ignorar archivos temporales o de sistema
.DS_Store
Thumbs.db

# Ignorar carpetas de uploads si no quieres que tus fotos de prueba se suban
assets/img/uploads/*

# Ignorar iconos personalizados subidos y el sprite generado a partir de ellos
# (se conserva la carpeta con .gitkeep, pero no su contenido)
assets/icons/personalizados/*
!assets/icons/personalizados/.gitkeep
assets/icons/sprite.svg

# Pipeline de forecast en Python (assets/librerias/python/): se versiona el fuente
# (forecast_prophet.py, requirements.txt); se ignora lo generado/pesado (entorno
# virtual, caché de bytecode y PNG).
assets/librerias/python/venv/
assets/librerias/python/__pycache__/
assets/librerias/python/*.pyc
assets/librerias/python/*.png

# CSVs generados por el pipeline de forecast/backtest: los crea el sistema al correr
# los scripts, no se versionan. Se conservan las carpetas con .gitkeep.
assets/librerias/python/forecast/*
!assets/librerias/python/forecast/.gitkeep
assets/librerias/python/backtest/*
!assets/librerias/python/backtest/.gitkeep