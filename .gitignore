# Ignorar archivos de configuración con credenciales reales de base de datos.
# Las conexiones (config/conexion.php y config/conexion_sqlserver.php) SÍ se versionan;
# las credenciales van en estos archivos, que se crean copiando los *.example.php.
config/config_mysql.php
config/config_sqlserver.php

# Ignorar archivos temporales o de sistema
.DS_Store
Thumbs.db

# Ignorar carpetas de uploads si no quieres que tus fotos de prueba se suban
assets/img/uploads/*

# Ignorar iconos personalizados subidos y el sprite generado a partir de ellos
# (se conserva la carpeta con .gitkeep, pero no su contenido)
assets/icons/personalizados/*
!assets/icons/personalizados/.gitkeep
assets/icons/sprite.svg